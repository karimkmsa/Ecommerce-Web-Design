<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Orders – Brand Store</title>
  <link rel="stylesheet" href="/css/order.css" />
</head>

<body>

  <!-- HEADER -->
  <header class="header">
    <div class="header-top">
      <a href="/" class="logo">
        <div class="logo-icon">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <rect x="2" y="2" width="16" height="16" rx="3" fill="white" opacity="0.9" />
            <path d="M6 8h8M6 11h5" stroke="#1a73e8" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </div>
        <span class="logo-text">Brand</span>
      </a>

      <form class="search-bar" action="/products" method="GET">

        <input type="text" class="search-input" name="keyword" placeholder="Search" value="<%= keyword %>" />

        <div class="search-divider"></div>

        <select class="search-category" name="category">

          <option value="">
            All category
          </option>

          <option value="Electronics" <%=category==="Electronics" ? "selected" : "" %>
            >
            Electronics
          </option>

          <option value="fashion" <%=category==="fashion" ? "selected" : "" %>
            >
            fashion
          </option>

          <option value="Home" <%=category==="Home" ? "selected" : "" %>
            >
            Home
          </option>

        </select>

        <button class="search-btn">
          Search
        </button>

      </form>

      <nav class="header-icons">

        <% if (user) { %>
          <a href="/profile" class="icon-link">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="8" r="4" />
              <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" />
            </svg>
            <span>Profile</span>
          </a>
          <% } else { %>
            <a href="/user/register" class="icon-link">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" />
              </svg>
              <span>Profile</span>
            </a>
            <% } %>

              <a href="#" class="icon-link">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" />
                </svg>
                <span>Message</span>
              </a>
              <% if(user){ %>

                <a href="/order/my-orders" class="icon-link">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                  </svg>
                  <span>Orders</span>
                </a>

                <% } %>
                  <a href="/cart" class="icon-link">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                      stroke-width="1.5">
                      <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" />
                      <line x1="3" y1="6" x2="21" y2="6" />
                      <path d="M16 10a4 4 0 01-8 0" />
                    </svg>

                    <span>My cart</span>
                  </a>
      </nav>
    </div>

    <div class="header-nav">
      <div class="nav-left">
        <a href="/products" class="nav-link nav-category">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
          All category
        </a>
        <a href="#" class="nav-link">Hot offers</a>
        <a href="#" class="nav-link">Gift boxes</a>
        <a href="#" class="nav-link">Projects</a>
        <a href="#" class="nav-link">Menu item</a>
        <a href="#" class="nav-link nav-dropdown">Help
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </a>
      </div>
      <div class="nav-right">
        <a href="#" class="nav-link nav-dropdown">English, USD
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </a>
        <a href="#" class="nav-link nav-dropdown">Ship to 🇩🇪
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </a>
      </div>
    </div>

  </header>
  <!-- ORDERS -->
  <div class="orders-wrapper">

    <h1 class="orders-title">My Orders</h1>

    <% if(orders.length===0){ %>

      <h2>No Orders Yet</h2>

      <% } %>

        <% orders.forEach(order=> { %>

          <div class="order-card">

            <div class="order-card-header">

              <div class="order-header-left">

                <div class="order-meta-group">

                  <span class="order-meta-label">
                    Order Placed
                  </span>

                  <span class="order-meta-value">

                    <%= order.createdAt.toDateString() %>

                  </span>

                </div>

                <div class="order-meta-group">

                  <span class="order-meta-label">
                    Total
                  </span>

                  <span class="order-meta-value">

                    $<%= order.totalPrice %>

                  </span>

                </div>

                <div class="order-meta-group">

                  <span class="order-meta-label">
                    Ship To
                  </span>

                  <span class="order-meta-value link">

                    <%= user.firstName %>
                      <%= user.lastName %>

                  </span>

                </div>

                <div class="order-meta-group">

                  <span class="order-meta-label">
                    Status
                  </span>

                  <span class="order-status <%= order.status %>">

                    <span class="order-status-dot"></span>

                    <%= order.status %>

                  </span>

                </div>

              </div>

              <span class="order-number">

                ORDER #
                <%= order._id %>

              </span>

            </div>

            <div class="order-items">

              <% order.products.forEach(item=> { %>

                <div class="order-item">

                  <div class="order-item-img">

                    <img src="/uploads/<%= item.image %>">
                  </div>

                  <div class="order-item-info">

                    <a href="/products/<%= item.product %>">

                      <div class="order-item-meta">

                        <span>

                          Qty:
                          <strong>

                            <%= item.quantity %>

                          </strong>

                        </span>

                        <span>

                          Price:
                          <strong>

                            $<%= item.price %>

                          </strong>

                        </span>

                        <span>

                          Subtotal:
                          <strong>

                            $<%= item.price * item.quantity %>

                          </strong>

                        </span>

                      </div>

                  </div>

                  <div class="order-item-actions">

                    <a href="/products/<%= item._id %>" class="btn-buy-again">

                      Buy Again

                    </a>

                  </div>

                </div>

                <% }) %>

            </div>

          </div>

          <% }) %>

  </div>

  <!-- Newsletter -->
  <div class="newsletter-wrap">
    <h2>Subscribe on our newsletter</h2>
    <p>Get daily news on upcoming offers from many suppliers all over the world</p>
    <div class="newsletter-form">
      <div class="newsletter-input-wrap">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="1.5">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
          <polyline points="22,6 12,13 2,6" />
        </svg>
        <input type="email" placeholder="Email" class="newsletter-input" />
      </div>
      <button class="newsletter-btn">Subscribe</button>
    </div>
  </div>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <a href="/" class="logo footer-logo">
          <div class="logo-icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <rect x="2" y="2" width="16" height="16" rx="3" fill="white" opacity="0.9" />
              <path d="M6 8h8M6 11h5" stroke="#1a73e8" stroke-width="1.5" stroke-linecap="round" />
            </svg></div><span class="logo-text">Brand</span>
        </a>
        <p class="footer-desc">Best information about the company gies here but now lorem ipsum is simply dummy text of
          the printing and typesetting industry.</p>
        <div class="footer-socials">
          <a href="#" class="social-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.8">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
            </svg></a>
          <a href="#" class="social-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.8">
              <path
                d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z" />
            </svg></a>
          <a href="#" class="social-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.8">
              <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z" />
              <rect x="2" y="9" width="4" height="12" />
              <circle cx="4" cy="4" r="2" />
            </svg></a>
          <a href="#" class="social-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.8">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg></a>
        </div>
      </div>
      <div class="footer-col">
        <h4>About</h4><a href="#">About Us</a><a href="#">Find store</a><a href="#">Categories</a><a href="#">Blogs</a>
      </div>
      <div class="footer-col">
        <h4>Partnership</h4><a href="#">About Us</a><a href="#">Find store</a><a href="#">Categories</a><a
          href="#">Blogs</a>
      </div>
      <div class="footer-col">
        <h4>Information</h4><a href="#">Help Center</a><a href="#">Money Refund</a><a href="#">Shipping</a><a
          href="#">Contact us</a>
      </div>
      <div class="footer-col">
        <h4>For users</h4><a href="#">Login</a><a href="#">Register</a><a href="#">Settings</a><a href="#">My Orders</a>
      </div>
      <div class="footer-col footer-app">
        <h4>Get app</h4>
        <a href="#" class="app-store-btn"><svg width="16" height="16" viewBox="0 0 24 24" fill="white">
            <path
              d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
          </svg>
          <div><span class="app-sub">Download on the</span><span class="app-name">App Store</span></div>
        </a>
        <a href="#" class="app-store-btn"><svg width="16" height="16" viewBox="0 0 24 24" fill="white">
            <path
              d="M3.18 23.76c.3.17.64.24.99.19l12.6-12.6L13.42 8l-10.24 14c-.17.3-.2.67-.05 1 .02.27.03.54.05.76zM20.45 10.64l-2.72-1.57-3.43 3.43 3.43 3.43 2.75-1.59c.78-.45.78-1.25-.03-1.7zM2 2.27c-.06.2-.06.42 0 .62v18.82c0 .2.06.42.18.6L13.42 11 2 2.27z" />
          </svg>
          <div><span class="app-sub">Get it on</span><span class="app-name">Google Play</span></div>
        </a>
      </div>
    </div>
  </footer>
  <div class="footer-bottom">
    <span>© 2023 Ecommerce.</span>
    <a href="#" class="footer-lang">🇺🇸 English <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2">
        <polyline points="18 15 12 9 6 15" />
      </svg></a>
  </div>

</body>

</html>